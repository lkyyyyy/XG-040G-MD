#
# Target
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_bell_xg-040g-md=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_12=y
CONFIG_VERSION_NUMBER="25.12.1-XG"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/25.12.1"

#
# Airoha hardware
#
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-i2c-an7581=y

#
# Base system ─ 这是最核心、最小系统必须的
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_busybox=y                  # 精简版工具集，几乎所有命令都靠它
CONFIG_DEFAULT_ca-bundle=y                # 根证书集合（https/wget/curl 等必须）
CONFIG_DEFAULT_logd=y                     # 系统日志守护进程
CONFIG_DEFAULT_procd=y                    # init 系统 / 服务管理核心
CONFIG_DEFAULT_uci=y                      # 配置系统（/etc/config/*）
CONFIG_DEFAULT_urandom-seed=y             # 随机种子保存/恢复（加密相关）
CONFIG_DEFAULT_urngd=y                    # 用户空间 RNG 守护进程
CONFIG_DEFAULT_netifd=y                   # 网络接口管理核心
CONFIG_DEFAULT_mtd=y                      # Flash 操作工具
CONFIG_DEFAULT_fstools=y                  # 文件系统挂载/检查工具
CONFIG_DEFAULT_block-mount=y              # 块设备挂载支持（USB 盘等）
CONFIG_DEFAULT_libc=y
CONFIG_DEFAULT_libgcc=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-ubootenv-nvram=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y

#
# Network ─ 基本 IPv4/IPv6 网络栈
#
CONFIG_PACKAGE_dnsmasq-full=y         # DNS + DHCP + TFTP（full 版，支持 DNS 分流/ipset 等）
CONFIG_PACKAGE_ip-full=y
CONFIG_IPV6=y                             # 全局 IPv6 支持（不是包，是内核选项）
CONFIG_DEFAULT_odhcp6c=y                  # IPv6 DHCP 客户端
CONFIG_DEFAULT_odhcpd-ipv6only=y          # IPv6-only DHCP 服务器（配合 dnsmasq）
CONFIG_PACKAGE_nftables=y                 # nft 核心工具
CONFIG_PACKAGE_firewall4=y                # nftables 版防火墙（取代旧 firewall）
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y         # nft 硬件转发支持（如果芯片支持）
CONFIG_PACKAGE_ethtool-full=y             # 查看接口速率、双工模式、自动协商状态。

#
# 包管理器：apk
#
# 添加这一行（默认已由系统启用，但显式指定更保险）：
CONFIG_PACKAGE_apk=y
CONFIG_DEFAULT_apk-tools=y                # apk 主程序包
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_DEFAULT_openwrt-keyring=y          # 签名验证密钥环（apk 生态常用，且官方镜像默认带）

#
# PPPoE
#
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

#
# SSH
#
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

#
# USB
#
CONFIG_USB_SUPPORT=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_libimobiledevice=y
CONFIG_PACKAGE_usbmuxd=y

#
# Filesystem (extroot)
#
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

#
# LuCI 语言
#
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

#
# 额外添加的包（用户自定义，非核心默认）
#
CONFIG_PACKAGE_luci=y                 # Web 管理
CONFIG_PACKAGE_luci-compat=y             # 兼容旧版 LuCI CBI 页面
CONFIG_PACKAGE_luci-ssl=y                 # LuCI HTTPS 支持
CONFIG_PACKAGE_luci-theme-bootstrap=y     # 保留 bootstrap 主题包（兜底）
CONFIG_PACKAGE_luci-theme-argon=y         # Argon 主题（默认主题）
CONFIG_PACKAGE_luci-app-argon-config=y    # Argon 主题配置（与 argon 主题配套）
CONFIG_PACKAGE_umdns=y                    # 本地 mDNS/zeroconf 支持（hostname.local 解析）
CONFIG_PACKAGE_kmod-mtd-rw=y              # MTD 分区临时写权限（用于 NAND/eMMC 恢复或刷写）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_fwtool=y

#
# 额外添加的包（用户自定义，非核心默认）
#
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_kmod-airoha-npu=y
CONFIG_PACKAGE_kmod-airoha-eth=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng=n
CONFIG_PACKAGE_default-settings-chn=y

#
# VPN 代理内核依赖（不装 passwall/openclash 主程序，只预装内核与组件）
# 说明：这样以后在 iStore/LuCI 里安装 passwall / openclash 时，依赖已齐，
#       无需再编译内核。注意这些包体积大，会显著增加固件大小。
#

# --- Xray 内核（passwall / openclash 最常用）---
CONFIG_PACKAGE_xray-core=y                 # Xray 核心

# --- Sing-box 内核（新版 passwall2 / openclash 用）---
CONFIG_PACKAGE_sing-box=y                  # sing-box 核心

# --- Shadowsocks 相关 ---
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y        # SS local（旧版 ss）
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y        # SS 透明代理
CONFIG_PACKAGE_shadowsocks-libev-ss-server=y       # SS server
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y      # SSR local
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y      # SSR 透明代理

# --- 其他常见协议内核 ---
CONFIG_PACKAGE_trojan-go=y                 # trojan-go
CONFIG_PACKAGE_hysteria=y                  # hysteria (udp 加速)
CONFIG_PACKAGE_naiveproxy=y                # naiveproxy
# CONFIG_PACKAGE_tuic-client is not set
CONFIG_PACKAGE_v2ray-geoip=y               # GeoIP 数据库（分流规则用）
CONFIG_PACKAGE_v2ray-geosite=y             # GeoSite 数据库（分流规则用）

# --- 代理辅助组件 ---
CONFIG_PACKAGE_iptables-mod-tproxy=y       # TPROXY 透明代理（passwall 依赖）
CONFIG_PACKAGE_iptables-mod-socket=y       # socket 匹配（openclash 依赖）
CONFIG_PACKAGE_iptables-mod-iprange=y      # iprange 匹配
CONFIG_PACKAGE_kmod-ipt-tproxy=y           # TPROXY 内核模块
CONFIG_PACKAGE_kmod-ipt-socket=y           # socket 内核模块

#
# 常用运维 / 网络工具（补充）
#

# --- 多 WAN 负载均衡 mwan3 ---
# 注意：mwan3 硬依赖 iptables；ImmortalWrt 25.12 的 iptables 是 nft 后端兼容层，
# 与 firewall4(nftables) 共存不冲突，只是体积增大
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# --- 网络排查 / 调试 ---
CONFIG_PACKAGE_tcpdump=y                  # 抓包（排查 DHCP/认证问题必备）
CONFIG_PACKAGE_ip-bridge=y                # bridge 命令（DSA/VLAN 操作，busybox 精简版没有）
CONFIG_PACKAGE_iperf3=y                   # 测速（验证多 WAN 叠加效果）
CONFIG_PACKAGE_ipset=y                    # ipset 集合
CONFIG_PACKAGE_conntrack-tools=y          # conntrack 连接跟踪查看
CONFIG_PACKAGE_dig-dig=y                  # DNS 排查（nslookup 替代）

# --- SSH / 文件传输 ---
CONFIG_PACKAGE_openssh-sftp-server=y      # 让 scp/sftp 可用（busybox 默认没有）

# --- 系统运维 ---
CONFIG_PACKAGE_htop=y                     # 进程/负载监控
CONFIG_PACKAGE_nano=y                     # 轻量编辑器
CONFIG_PACKAGE_bash=y                     # bash（写脚本更顺手）
CONFIG_PACKAGE_screen=y                   # 会话保持
CONFIG_PACKAGE_luci-app-ttyd=y            # 网页终端（不用 SSH 也能进命令行）

# --- 单线多拨相关（如需 macvlan 虚拟网卡）---
CONFIG_PACKAGE_kmod-macvlan=y

#
# 市面常用功能（按场景分类）
#

# --- 内网穿透 / 远程访问 ---
CONFIG_PACKAGE_frp=y                       # frp 内网穿透
CONFIG_PACKAGE_luci-app-frpc=y             # frp 客户端 LuCI
CONFIG_PACKAGE_luci-app-frps=y             # frp 服务端 LuCI
CONFIG_PACKAGE_luci-app-ddns=y             # 动态 DNS
CONFIG_PACKAGE_ddns-scripts-cloudflare=y   # DDNS Cloudflare
CONFIG_PACKAGE_luci-app-wol=y              # 网络唤醒
CONFIG_PACKAGE_luci-app-zerotier=y         # ZeroTier 虚拟局域网

# --- 家庭媒体 / 文件 ---
CONFIG_PACKAGE_luci-app-samba4=y           # SMB 文件共享（已在上方，保留）
CONFIG_PACKAGE_luci-app-minidlna=y         # DLNA 媒体服务器
CONFIG_PACKAGE_luci-app-aria2=y            # 下载工具
CONFIG_PACKAGE_luci-app-qbittorrent=y      # BT 下载（需空间）
CONFIG_PACKAGE_luci-app-transmission=y     # BT 下载（轻量替代）

# --- 网络服务 ---
CONFIG_PACKAGE_luci-app-upnp=y             # UPnP（游戏机/BT 端口映射）
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set   # 去广告：需 kenzok8/openwrt-packages feed，暂不启用
# CONFIG_PACKAGE_luci-app-smartdns is not set       # 智能 DNS：需独立 feed，暂不启用
CONFIG_PACKAGE_luci-app-sqm=y              # SQM QoS 流量整形
CONFIG_PACKAGE_luci-app-nlbwmon=y          # 实时流量监控
CONFIG_PACKAGE_luci-app-wireguard=y        # WireGuard VPN
CONFIG_PACKAGE_luci-app-openvpn=y          # OpenVPN
CONFIG_PACKAGE_luci-app-pppoe-server=y     # PPPoE 服务器

# --- 系统管理 ---
CONFIG_PACKAGE_luci-app-statistics=y       # collectd 系统统计
CONFIG_PACKAGE_luci-app-commands=y         # 自定义命令（网页执行脚本）
CONFIG_PACKAGE_luci-app-diskman=y          # 磁盘管理
CONFIG_PACKAGE_luci-app-hd-idle=y          # 硬盘休眠
CONFIG_PACKAGE_luci-app-filetransfer=y     # 网页文件上传下载

# --- 网络诊断 ---
CONFIG_PACKAGE_luci-app-vnstat=y           # 流量统计（包名是 vnstat，不是 vnstat2）
CONFIG_PACKAGE_luci-app-travelmate=y       # 中继旅行模式

# --- 常用命令行工具 ---
CONFIG_PACKAGE_coreutils=y                 # 完整 coreutils（cat/tail/sleep 等）
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_rsync=y                     # 文件同步
CONFIG_PACKAGE_unzip=y                     # 解压 zip
CONFIG_PACKAGE_p7zip=y                     # 7z 压缩解压
CONFIG_PACKAGE_lsof=y                      # 查看文件占用
CONFIG_PACKAGE_strace=y                    # 系统调用跟踪
CONFIG_PACKAGE_procps-ng-ps=y              # 完整 ps（busybox 精简版功能弱）
CONFIG_PACKAGE_sed=y                       # 完整 sed

